#!/bin/sh
set -eu
cd "$(dirname "$0")/.."

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 VERSION" >&2
    exit 2
fi
case "$1" in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) echo "Provide an explicit version, such as 11.2.0-rc1." >&2; exit 2 ;;
esac

if [ -n "$(git status --porcelain)" ]; then
    echo "Commit or set aside working tree changes before releasing." >&2
    exit 1
fi

./scripts/check
cargo release "$1"
exec cargo release "$1" --execute
